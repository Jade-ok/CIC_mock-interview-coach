# Local development uses one process for HTTP and voice traffic.
VITE_RUNTIME_MODE=local
VITE_USE_MOCK_WEBSOCKET=false

# To exercise a local frontend against an existing hosted backend, set
# VITE_RUNTIME_MODE=hosted in .env.local and provide its CloudFront API base URL.
# This endpoint identifier is not an AWS credential.
VITE_API_BASE_URL=

{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "MockInterviewVoice",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "MockInterviewVoice"
  },
  "runtimes": [
    {
      "name": "MockInterviewVoiceRelay",
      "build": "Container",
      "entrypoint": "server.py",
      "codeLocation": ".",
      "runtimeVersion": "PYTHON_3_12",
      "envVars": [
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "MODEL_ID",
          "value": "amazon.nova-2-sonic-v1:0"
        },
        {
          "name": "HOSTED_GUARDRAILS_ENABLED",
          "value": "true"
        }
      ],
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "authorizerType": "AWS_IAM",
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 900,
        "maxLifetime": 3600
      }
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
